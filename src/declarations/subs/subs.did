   endDate: opt nat;
   interval: Interval;
   productId: opt nat;
   serviceCanister: principal;
   status: SubStatus;
   subscriptionId: nat;
   targetAccount: opt Account;
   tokenCanister: principal;
   tokenPointer: opt blob;
 };
type Subs = 
 service {
   add_blocked_service: ("principal": principal, bBlock: bool) -> ();
   add_token: (tokenCanister: principal, tokenPointer: opt blob) ->
    (opt TokenInfo);
   get_token_info: () -> (vec TokenInfo) query;
   icrc10_supported_standards: () ->
    (vec record {
           name: text;
           url: text;
         }) query;
   icrc3_get_archives: (args: GetArchivesArgs) -> (GetArchivesResult) query;
   icrc3_get_blocks: (args: GetBlocksArgs) -> (GetBlocksResult) query;
   icrc3_get_tip_certificate: () -> (opt DataCertificate) query;
   icrc3_supported_block_types: () -> (vec BlockType) query;
   icrc79_cancel_subscription: (req:
    vec record {
          reason: text;
          subscriptionId: nat;
        }) -> (vec CancelResult);
   icrc79_cancel_subscription_0_0_1: (req:
    vec record {
          reason: text;
          subscriptionId: nat;
        }) -> (vec CancelResult);
   icrc79_confirm_subscription: (confirmRequests: vec ConfirmRequests) ->
    (vec ConfirmResult);
   icrc79_confirm_subscription_0_0_1: (confirmRequests:
    vec ConfirmRequests) -> (vec ConfirmResult);
   icrc79_default_take_value: () -> (nat) query;
   icrc79_default_take_value_0_0_1: () -> (nat) query;
   icrc79_get_payments_pending: (subscriptionIds: vec nat) ->
    (vec opt PendingPayment) query;
   icrc79_get_payments_pending_0_0_1: (subscriptionIds: vec nat) ->
    (vec opt PendingPayment) query;
   icrc79_get_service_notifications: ("service": principal, prev: opt nat,
    take: opt nat) -> (vec ServiceNotification) query;
   icrc79_get_service_notifications_0_0_1: ("service": principal, prev:
    opt nat, take: opt nat) -> (vec ServiceNotification) query;
   icrc79_get_service_payments: ("service": principal, filter:
    opt ServiceSubscriptionFilter, prev: opt nat, take: opt nat) ->
    (vec PaymentRecord) query;
   icrc79_get_service_payments_0_0_1: ("service": principal, filter:
    opt ServiceSubscriptionFilter, prev: opt nat, take: opt nat) ->
    (vec PaymentRecord) query;
   icrc79_get_service_subscriptions: ("service": principal, filter:
    opt ServiceSubscriptionFilter, prev: opt nat, take: opt nat) ->
    (vec Subscription) query;
   icrc79_get_service_subscriptions_0_0_1: ("service": principal, filter:
    opt ServiceSubscriptionFilter, prev: opt nat, take: opt nat) ->
    (vec Subscription) query;
   icrc79_get_user_payments: (filter: opt UserSubscriptionsFilter, prev:
    opt nat, take: opt nat) -> (vec PaymentRecord) query;
   icrc79_get_user_payments_0_0_1: (filter: opt UserSubscriptionsFilter,
    prev: opt nat, take: opt nat) -> (vec PaymentRecord) query;
   icrc79_get_user_subscriptions: (filter: opt UserSubscriptionsFilter, prev:
    opt nat, take: opt nat) -> (vec Subscription) query;
   icrc79_get_user_subscriptions_0_0_1: (filter: opt UserSubscriptionsFilter,
    prev: opt nat, take: opt nat) -> (vec Subscription) query;
   icrc79_max_memo_size: () -> (nat) query;
   icrc79_max_memo_size_0_0_1: () -> (nat) query;
   icrc79_max_query_batch_size: () -> (nat) query;
   icrc79_max_query_batch_size_0_0_1: () -> (nat) query;
   icrc79_max_take_value: () -> (nat) query;
   icrc79_max_take_value_0_0_1: () -> (nat) query;
   icrc79_max_update_batch_size: () -> (nat) query;
   icrc79_max_update_batch_size_0_0_1: () -> (nat) query;
   icrc79_metadata: () -> (vec record {
